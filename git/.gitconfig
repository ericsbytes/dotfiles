# This is Git's per-user configuration file.
[user]
	name = eric wu
	email = lite@duck.com
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[core]
	excludesFile = ~/.gitignore

[push]
	autoSetupRemote = true

[merge]
    conflictStyle = zdiff3
